<header class="headerBox">
	<img class="profile-img" src="{{actor.img}}" {{#if isEditable}} data-edit="img" data-action="editImage" {{/if}} title="{{actor.name}}"/>
	<div class="basicFieldsBox">
		<input class="characterName bigInputText" type="text" name="name" value="{{actor.name}}">
		<input class="characterFullName inputText" type="text" name="system.fullName" value="{{system.fullName}}" placeholder="{{localize "SINLESS.System.FullName"}}">
		<input class="heritage inputText" type="text" name="system.heritage" value="{{system.heritage}}" placeholder="{{localize "SINLESS.System.Heritage"}}">
		<input class="movement inputText" type="text" name="system.movement" value="{{system.movement}}" placeholder="{{localize "SINLESS.System.Movement"}}">
	</div>
	<dl class="statusBox flexcol center">
		<dt><label for="phys-value">{{localize "SINLESS.System.Physical"}}</label></dt>
		<dd class="flexrow">
			<input class="input" id="phys-value" type="number" name="system.condition.phys.value" value="{{system.condition.phys.value}}">
			<span class="center"> / </span>
			<input class="input" type="number" name="system.condition.phys.max" value="{{system.condition.phys.max}}" readonly>
		</dd>
		<dt><label for="stun-value">{{localize "SINLESS.System.Stun"}}</label></dt>
		<dd class="flexrow">
			<input class="input" id="stun-value" type="number" name="system.condition.stun.value" value="{{system.condition.stun.value}}">
			<span class="center"> / </span>
			<input class="input" type="number" name="system.condition.stun.max" value="{{system.condition.stun.max}}" readonly>
		</dd>
	</dl>
	<dl class="extraInfoBox flexCol center">
		<div class="derivedDamageBox">
			<dt><label for="damageOver-value">{{localize "SINLESS.System.Over"}}</label></dt>
			<dt><label for="damagePenalty-value">{{localize "SINLESS.System.ConditionPenalty"}}</label></dt>
			<dd><input class="input" id="damageOver-value" type="number" name="system.damageOverflow" value="{{system.damageOverflow}}" ></dd>
			<dd><input class="damagePenaltyValue input" type="number" value="{{system.condition.penalty}}" readonly></dd>
		</div>
		<div class="armorBox">
			<dt><label>{{localize "SINLESS.System.Armor.B/I"}}</label></dt>
			<dd class="flexrow">
				<input class="input" type="number"name="system.armor.ballistic" value="{{system.armor.ballistic}}" readonly>
				<span class="center"> / </span>
				<input class="input" type="number" name="system.armor.impact" value="{{system.armor.impact}}" readonly>
			</dd>
		</div>
	</dl>
</header>