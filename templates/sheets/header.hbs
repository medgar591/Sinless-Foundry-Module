<div class="headerBox flexrow">
	<img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" height="100" width="100" style="max-width: fit-content;"/>
	<div class="basicFieldsBox flexcol">
		<input class="characterName bigInputText" type="text" name="name" value="{{actor.name}}">
		<input class="characterFullName inputText" type="text" name="system.fullName" value="{{system.fullName}}" placeholder="{{localize "SINLESS.System.FullName"}}">
		<input class="heritage inputText" type="text" name="system.heritage" value="{{system.heritage}}" placeholder="{{localize "SINLESS.System.Heritage"}}">
		<input class="movement inputText" type="text" name="system.movement" value="{{system.movement}}" placeholder="{{localize "SINLESS.System.Movement"}}">
	</div>
	<div class="statusBox flexrow">
		<div class="conditionBox flexcol" style="align-items: center;">
			<div class="conditionPhysLabel flex-center">{{localize "SINLESS.System.Physical"}}</div>
			<div class="conditionPhysEntryBox flexrow">
				<input class="conditionPhysValue input" type="number" name="system.condition.phys.value" value="{{system.condition.phys.value}}">
				<div class="conditionPhysDivider center"> / </div>
				<input class="conditionPhysMax input" type="number" name="system.condition.phys.max" value="{{system.condition.phys.max}}" disabled>
			</div>
			<div class="conditionStunLabel">{{localize "SINLESS.System.Stun"}}</div>
			<div class="conditionStunEntryBox flexrow">
				<input class="conditionStunValue input" type="number" name="system.condition.stun.value" value="{{system.condition.stun.value}}">
				<div class="conditionStunDivider center"> / </div>
				<input class="conditionStunMax input" type="number" name="system.condition.stun.max" value="{{system.condition.stun.max}}" disabled>
			</div>
		</div>
	</div>
	<div class="extraInfoBox flexcol">
		<div class="derivedDamageBox flexrow">
			<div class="damageOverBox flexcol" style="align-items: center;">
				<div class="damageOverLabel">{{localize "SINLESS.System.Over"}}</div>
				<input class="damageOverValue input" type="number" name="system.damageOverflow" value="{{system.damageOverflow}}" >
			</div>
			<div class="damagePenaltyBox flexcol" style="align-items: center;">
				<div class="damagePenaltybel">{{localize "SINLESS.System.ConditionPenalty"}}</div>
				<input class="damagePenaltyValue input" type="number" value="{{system.condition.penalty}}" disabled>
			</div>
		</div>
		<div class="armorBox flexcol" style="align-items: center;">
			<div class="armorLabel">{{localize "SINLESS.System.Armor.B/I"}}</div>
			<div class="armorEntryBox flexrow">
				<input class="armorBallisticValue input" type="number"name="system.armor.ballistic" value="{{system.armor.ballistic}}" disabled>
				<div class="armorDivider center"> / </div>
				<input class="armorImpactValue input" type="number" name="system.armor.impact" value="{{system.armor.impact}}" disabled>
			</div>
		</div>
	</div>
</div>