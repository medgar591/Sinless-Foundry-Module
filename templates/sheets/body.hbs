<div class="body flexrow">
	<div class="sidebar flexcol">
		<div class="poolsBox flexcol">
			{{#each system.pools as |pool key|}}
			<div class="poolLabel flex-left">{{localize (concat "SINLESS.System." key)}}</div>
			<div class="poolEntry flexrow">
				<input class="poolValue input" type="number" name="system.pools.{{key}}.value" value="{{pool.value}}">
				<div class="poolDivider center"> / </div>
				<input class="poolMax input" type="number" name="system.pools.{{key}}.max" value="{{pool.max}}" disabled>
			</div>
			{{/each}}
		</div>
		<div class="menuBox">
			<nav class="tabs vertical" data-group="primary-tabs">
				<div class="menuBar">
					<a class="item" data-tab="tab1" data-group="primary-tabs">
						{{localize "SINLESS.System.Attributes.title"}}
					</a>
				</div>
				<div class="menuBar">
					<a class="item" data-tab="tab2" data-group="primary-tabs">
						{{localize "SINLESS.System.ActiveSkills"}}
					</a>
				</div>
				<div class="menuBar">
					<a class="item" data-tab="tab3" data-group="primary-tabs">
						{{localize "SINLESS.System.SecondarySkills"}}
					</a>
				</div>
				<div class="menuBar">
					<a class="item disabled" data-tab="tab4" data-group="primary-tabs">
						{{localize "SINLESS.System.Gear"}} (WIP)
					</a>
				</div>
				<div class="menuBar">
					<a class="item" data-tab="tab5" data-group="primary-tabs">
						{{localize "SINLESS.System.Notes"}}
					</a>
				</div>
				<div class="menuBar">
					<a class="item disabled" data-tab="tab6" data-group="primary-tabs">
						{{localize "SINLESS.System.Rigger"}} (WIP)
					</a>
				</div>
				<div class="menuBar">
					<a class="item disabled" data-tab="tab7" data-group="primary-tabs">
						{{localize "SINLESS.System.Decker"}} (WIP)
					</a>
				</div>
				<div class="menuBar">
					<a class="item disabled" data-tab="tab8" data-group="primary-tabs">
						{{localize "SINLESS.System.Mage"}} (WIP)
					</a>
				</div>
				<div class="menuBar">
					<a class="item disabled" data-tab="tab9" data-group="primary-tabs">
						{{localize "SINLESS.System.Shaman"}} (WIP)
					</a>
				</div>
			</nav>
		</div>
		
	</div>
	<section class="content">
		<div class="tab" data-tab="tab1" data-group="primary-tabs">
			{{> "systems/sinless/templates/partials/character-sheet-attributes.hbs"}}
		</div>
		<div class="tab" data-tab="tab2" data-group="primary-tabs">
			{{> "systems/sinless/templates/partials/character-sheet-skills.hbs"}}
		</div>
		<div class="tab" data-tab="tab3" data-group="primary-tabs">
			{{> "systems/sinless/templates/partials/character-sheet-skills2.hbs"}}
		</div>
		<div class="tab" data-tab="tab5" data-group="primary-tabs">
			{{> "systems/sinless/templates/partials/character-sheet-notes.hbs"}}
		</div>
	</section>
</div>