<div class="body flexrow">
	<div class="sidebar flexcol">
		<div class="poolsBox flexcol">
			<div class="poolLabel flex-left">Brawn</div>
			<div class="poolEntry flexrow">
				<input class="poolValue input" type="number" name="system.pools.brawn.value" value="{{system.pools.brawn.value}}">
				<div class="poolDivider center"> / </div>
				<input class="poolMax input" type="number" name="system.pools.brawn.max" value="{{system.pools.brawn.max}}" disabled>
			</div>
			<div class="poolLabel flex-left">Finesse</div>
			<div class="poolEntry flexrow">
