<div class="body flexrow">
	<div class="sidebar flexcol">
		<div class="poolsBox flexcol">
			{{#each system.pools as |pool key|}}
			<div class="poolLabel flex-left">{{localize (concat "SINLESS.System." key)}}</div>
			<div class="poolEntry flexrow">
				<input class="poolValue input" type="number" name="system.pools.{{key}}.value" value="{{pool.value}}">
				<div class="poolDivider center"> / </div>
				<input class="poolMax input" type="number" name="system.pools.{{key}}.max" value="{{pool.max}}" disabled>
			</div>
			{{/each}}
		</div>
		<div class="menuBox">
			<nav class="tabs vertical" data-group="primary">
				<div class="menuBar">
					<a class="item {{tabs.attributes.cssClass}}" data-action="tab" data-tab="attributes" data-group="primary">
						{{localize "SINLESS.System.Attributes.title"}}
					</a>
				</div>
				<div class="menuBar">
					<a class="item {{tabs.activeSkills.cssClass}}" data-action="tab" data-tab="activeSkills" data-group="primary">
						{{localize "SINLESS.System.ActiveSkills"}}
					</a>
				</div>
				<div class="menuBar">
					<a class="item {{tabs.secondarySkills.cssClass}}" data-action="tab" data-tab="secondarySkills" data-group="primary">
						{{localize "SINLESS.System.SecondarySkills"}}
					</a>
				</div>
				<div class="menuBar">
					<a class="item disabled" data-action="tab" data-tab="tab4" data-group="primary">
						{{localize "SINLESS.System.Gear"}} (WIP)
					</a>
				</div>
				<div class="menuBar">
					<a class="item {{tabs.notes.cssClass}}" data-action="tab" data-tab="notes" data-group="primary">
						{{localize "SINLESS.System.Notes"}}
					</a>
				</div>
				<div class="menuBar">
					<a class="item disabled" data-action="tab" data-tab="tab6" data-group="primary">
						{{localize "SINLESS.System.Rigger"}} (WIP)
					</a>
				</div>
				<div class="menuBar">
					<a class="item disabled" data-action="tab" data-tab="tab7" data-group="primary">
						{{localize "SINLESS.System.Decker"}} (WIP)
					</a>
				</div>
				<div class="menuBar">
					<a class="item disabled" data-action="tab" data-tab="tab8" data-group="primary">
						{{localize "SINLESS.System.Mage"}} (WIP)
					</a>
				</div>
				<div class="menuBar">
					<a class="item disabled" data-action="tab" data-tab="tab9" data-group="primary">
						{{localize "SINLESS.System.Shaman"}} (WIP)
					</a>
				</div>
			</nav>
		</div>
		
	</div>
	<section class="content">
		{{> "systems/sinless/templates/partials/character-sheet-attributes.hbs"}}
		{{> "systems/sinless/templates/partials/character-sheet-skills.hbs"}}
		{{> "systems/sinless/templates/partials/character-sheet-skills2.hbs"}}
		{{> "systems/sinless/templates/partials/character-sheet-notes.hbs"}}
	</section>
</div>