<div class="skillsBox flexcol">
	<h4>{{localize "SINLESS.System.Brawn"}}</h4>
	<div class="skill flexrow">
		<label class="skillLabel" for="system.skills.brawn.athletics.value">{{localize "SINLESS.System.Skills.athletics"}}</label>
		<div class="flexrow">
			<input class="input" type="number" name="system.skills.brawn.athletics.value" value="{{system.skills.brawn.athletics.value}}" data-dtype="Number">
			<span class="center"> / </span>
			<input class="input" type="number" name="system.skills.brawn.athletics.max" value="{{system.skills.brawn.athletics.max}}" data-dtype="Number">
		</div>
	</div>
	<h6>{{localize "SINLESS.System.Skills.meta.melee"}}: {{system.skills.meta.melee}}</h6>
	<div class="indent">
		<div class="skill flexrow">
			<label class="skillLabel" for="system.skills.brawn.cyberneticCombat.value">{{localize "SINLESS.System.Skills.cyberneticCombat"}}</label>
			<div class="flexrow">
				<input class="input" type="number" name="system.skills.brawn.cyberneticCombat.value" value="{{system.skills.brawn.cyberneticCombat.value}}" data-dtype="Number">
				<span class="center"> / </span>
				<input class="input" type="number" name="system.skills.brawn.cyberneticCombat.max" value="{{system.skills.brawn.cyberneticCombat.max}}" data-dtype="Number">
			</div>
		</div>
		<div class="skill flexrow">
			<input class="inputText" type="text" name="system.skills.brawn.martialArts.name" value="{{system.skills.brawn.martialArts.name}}" placeholder="{{localize "SINLESS.System.Skills.martialArts"}}" >
			<div class="flexrow">
				<input class="input" type="number" name="system.skills.brawn.martialArts.value" value="{{system.skills.brawn.martialArts.value}}" data-dtype="Number">
				<span class="center"> / </span>
				<input class="input" type="number" name="system.skills.brawn.martialArts.max" value="{{system.skills.brawn.martialArts.max}}" data-dtype="Number">
			</div>
		</div>
		<div class="skill flexrow">
			<label class="skillLabel" for="system.skills.brawn.meleeWeapons.value">{{localize "SINLESS.System.Skills.meleeWeapons"}}</label>
			<div class="flexrow">
				<input class="input" type="number" name="system.skills.brawn.meleeWeapons.value" value="{{system.skills.brawn.meleeWeapons.value}}" data-dtype="Number">
				<span class="center"> / </span>
				<input class="input" type="number" name="system.skills.brawn.meleeWeapons.max" value="{{system.skills.brawn.meleeWeapons.max}}" data-dtype="Number">
			</div>
		</div>
		<div class="skill flexrow">
			<label class="skillLabel" for="system.skills.brawn.throwingWeapons.value">{{localize "SINLESS.System.Skills.throwingWeapons"}}</label>
			<div class="flexrow">
				<input class="input" type="number" name="system.skills.brawn.throwingWeapons.value" value="{{system.skills.brawn.throwingWeapons.value}}" data-dtype="Number">
				<span class="center"> / </span>
				<input class="input" type="number" name="system.skills.brawn.throwingWeapons.max" value="{{system.skills.brawn.throwingWeapons.max}}" data-dtype="Number">
			</div>
		</div>
		<div class="skill flexrow">
			<label class="skillLabel" for="system.skills.brawn.unarmedCombat.value">{{localize "SINLESS.System.Skills.unarmedCombat"}}</label>
			<div class="flexrow">
				<input class="input" type="number" name="system.skills.brawn.unarmedCombat.value" value="{{system.skills.brawn.unarmedCombat.value}}" data-dtype="Number">
				<span class="center"> / </span>
				<input class="input" type="number" name="system.skills.brawn.unarmedCombat.max" value="{{system.skills.brawn.unarmedCombat.max}}" data-dtype="Number">
			</div>
		</div>
	</div>

