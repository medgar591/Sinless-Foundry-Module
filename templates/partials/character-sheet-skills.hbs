<div class="skillsBox flexcol">
	<h4>{{localize "SINLESS.System.Brawn"}}</h4>
	<div class="skill flexrow">
		<label class="skillLabel" for="system.skills.brawn.athletics.value">{{localize "SINLESS.System.Skills.athletics"}}</label>
		<div class="flexrow">
			<input class="input" type="number" name="system.skills.brawn.athletics.value" value="{{system.skills.brawn.athletics.value}}" data-dtype="Number">
			<span class="center"> / </span>
			<input class="input" type="number" name="system.skills.brawn.athletics.max" value="{{system.skills.brawn.athletics.max}}" data-dtype="Number">
		</div>
	</div>

	{{#each system.skills.brawn as |skill key|}}
	<div class="skill flexrow">
		<label class="skillLabel" for="system.skills.brawn.{{key}}.value">{{key}}</label>
		<div class="flexrow">
			<input class="input" type="number" name="system.skills.brawn.{{skill}}.value" value="{{skill.value}}" data-dtype="Number">
			<span class="center"> / </span>
			<input class="input" type="number" name="system.skills.brawn.{{skill}}.max" value="{{skill.max}}" data-dtype="Number">
		</div>
	</div>
	{{/each}}
	<h4>Finesse</h4>
	{{#each system.skills.finesse as |skill key|}}
	<div class="skill flexrow">
		<label class="skillLabel" for="system.skills.finesse.{{key}}.value">{{key}}</label>
		<div class="flexrow">
			<input class="input" type="number" name="system.skills.finesse.{{skill}}.value" value="{{skill.value}}" data-dtype="Number">
			<span class="center"> / </span>
			<input class="input" type="number" name="system.skills.finesse.{{skill}}.max" value="{{skill.max}}" data-dtype="Number">
		</div>
	</div>
	{{/each}}
	<h4>Focus</h4>
	{{#each system.skills.focus as |skill key|}}
	<div class="skill flexrow">
		<label class="skillLabel" for="system.skills.focus.{{key}}.value">{{key}}</label>
		<div class="flexrow">
			<input class="input" type="number" name="system.skills.focus.{{skill}}.value" value="{{skill.value}}" data-dtype="Number">
			<span class="center"> / </span>
			<input class="input" type="number" name="system.skills.focus.{{skill}}.max" value="{{skill.max}}" data-dtype="Number">
		</div>
	</div>
	{{/each}}
	<h4>Resoluve</h4>
	{{#each system.skills.resolve as |skill key|}}
	<div class="skill flexrow">
		<label class="skillLabel" for="system.skills.resolve.{{key}}.value">{{key}}</label>
		<div class="flexrow">
			<input class="input" type="number" name="system.skills.resolve.{{skill}}.value" value="{{skill.value}}" data-dtype="Number">
			<span class="center"> / </span>
			<input class="input" type="number" name="system.skills.resolve.{{skill}}.max" value="{{skill.max}}" data-dtype="Number">
		</div>
	</div>
	{{/each}}
</div>