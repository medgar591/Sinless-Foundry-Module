			<span class="center"> / </span>
			<input class="input" type="number" name="system.skills.finesse.articulatedManeuvers.max" value="{{system.skills.finesse.articulatedManeuvers.max}}" data-dtype="Number">
		</div>
	</div>
	<h6>{{localize "SINLESS.System.Skills.meta.ranged"}}: {{system.skills.meta.ranged}}</h6>
	<div class="indent">
		<div class="skill flexrow">
			<label class="skillLabel" for="system.skills.finesse.energyWeapons.value">{{localize "SINLESS.System.Skills.energyWeapons"}}</label>
			<div class="flexrow">
				<input class="input" type="number" name="system.skills.finesse.energyWeapons.value" value="{{system.skills.finesse.energyWeapons.value}}" data-dtype="Number">
				<span class="center"> / </span>
				<input class="input" type="number" name="system.skills.finesse.energyWeapons.max" value="{{system.skills.finesse.energyWeapons.max}}" data-dtype="Number">
			</div>
		</div>
		<div class="skill flexrow">
			<label class="skillLabel" for="system.skills.finesse.firearms.value">{{localize "SINLESS.System.Skills.firearms"}}</label>
			<div class="flexrow">
				<input class="input" type="number" name="system.skills.finesse.firearms.value" value="{{system.skills.finesse.firearms.value}}" data-dtype="Number">
				<span class="center"> / </span>
				<input class="input" type="number" name="system.skills.finesse.firearms.max" value="{{system.skills.finesse.firearms.max}}" data-dtype="Number">
			</div>
		</div>
		<div class="skill flexrow">
			<label class="skillLabel" for="system.skills.finesse.gunnery.value">{{localize "SINLESS.System.Skills.gunnery"}}</label>
			<div class="flexrow">
				<input class="input" type="number" name="system.skills.finesse.gunnery.value" value="{{system.skills.finesse.gunnery.value}}" data-dtype="Number">
				<span class="center"> / </span>
				<input class="input" type="number" name="system.skills.finesse.gunnery.max" value="{{system.skills.finesse.gunnery.max}}" data-dtype="Number">
			</div>
		</div>
		<div class="skill flexrow">
			<label class="skillLabel" for="system.skills.finesse.heavyWeapons.value">{{localize "SINLESS.System.Skills.heavyWeapons"}}</label>
			<div class="flexrow">
				<input class="input" type="number" name="system.skills.finesse.heavyWeapons.value" value="{{system.skills.finesse.heavyWeapons.value}}" data-dtype="Number">
				<span class="center"> / </span>
				<input class="input" type="number" name="system.skills.finesse.heavyWeapons.max" value="{{system.skills.finesse.heavyWeapons.max}}" data-dtype="Number">
			</div>
		</div>
	</div>

	<h4>Focus</h4>
	{{#each system.skills.focus as |skill key|}}
	<div class="skill flexrow">
		<label class="skillLabel" for="system.skills.focus.{{key}}.value">{{key}}</label>
		<div class="flexrow">
			<input class="input" type="number" name="system.skills.focus.{{skill}}.value" value="{{skill.value}}" data-dtype="Number">
			<span class="center"> / </span>
			<input class="input" type="number" name="system.skills.focus.{{skill}}.max" value="{{skill.max}}" data-dtype="Number">
		</div>
	</div>
	{{/each}}

	<h4>{{localize "SINLESS.System.Resolve"}}</h4>
	{{#each system.skills.resolve as |skill key|}}
	<div class="skill flexrow">
		<label class="skillLabel" for="system.skills.resolve.{{key}}.value">{{localize (concat "SINLESS.System.Skills." key)}}</label>
		<div class="flexrow">
			<input class="input" type="number" name="system.skills.resolve.{{key}}.value" value="{{skill.value}}" data-dtype="Number">
			<span class="center"> / </span>
			<input class="input" type="number" name="system.skills.resolve.{{key}}.max" value="{{skill.max}}" data-dtype="Number">
		</div>
	</div>
	{{/each}}
</div>