<div class="flexcol">
	<h4 class="center">{{localize "SINLESS.System.Attributes.titlePrimary"}}</h4>
	{{#each system.attributes as |attribute key|}}
	<div class="attribute flexrow">
		<label class="attributeLabel" for="system.attributes.{{key}}.value">{{localize  (concat "SINLESS.System.Attributes." key) }}</label>
		<div class="flexrow">
			<input class="input" type="number" name="system.attributes.{{key}}.value" value="{{attribute.value}}" data-dtype="Number">
			<span class="center"> / </span>
			<input class="input" type="number" name="system.attributes.{{key}}.max" value="{{attribute.max}}" data-dtype="Number">
		</div>
	</div>
	{{/each}}
	<h4 class="center">{{localize "SINLESS.System.Attributes.titleSecondary"}}</h4>
	<div class="attribute flexrow">
		<label class="attributeLabel">{{localize "SINLESS.System.ZP.full"}}</label>
		<div class="flexrow">
			{{system.zp.value}} (
			<input class="input" type="number" name="system.zp.exact" value="{{system.zp.exact}}" data-dtype="Number" step="0.01">
			) / 
			<input class="input" type="number" name="system.zp.base" value="{{system.zp.base}}" data-dtype="Number">
		</div>
	</div>
	<div class="attribute flexrow">
		<label class="attributeLabel">{{localize "SINLESS.System.BI.full"}}</label>
		<div>
			<input class="input" type="number" name="system.bi" value="{{system.bi}}" data-dtype="Number" placeholder="0">
		</div>
	</div>
	<div class="attribute flexrow">
		<label class="attributeLabel">{{localize "SINLESS.System.Kismet"}}</label>
		<div class="flexrow">
			<input class="input" type="number" name="system.kismet.value" value="{{system.kismet.value}}" data-dtype="Number" placeholder="0">
			<span class="center"> / </span>
			<input class="input" type="number" name="system.kismet.max" value="{{system.kismet.max}}" data-dtype="Number" placeholder="0">
		</div>
	</div>
	<div class="attribute flexrow">
		<label class="attributeLabel">{{localize "SINLESS.System.GhostRating"}}</label>
		<div>
			<input class="input" type="number" name="system.ghost" value="{{system.ghost}}" data-dtype="Number" placeholder="0">
		</div>
	</div>
	<h4 class="center">{{localize "SINLESS.System.Armor.title"}}</h4>
	<div class="flexrow">
		<span class="center"></span>
		<span class="center">{{localize "SINLESS.System.Armor.Ballistic"}}</span>
		<span class="center">{{localize "SINLESS.System.Armor.Impact"}}</span>
	</div>
	<div class="flexrow">
		<span class="center">{{localize "SINLESS.System.Armor.Internal"}}</span>
		<input class="input" type="number" name="system.armorDetail.internal.ballistic" value="{{system.armorDetail.internal.ballistic}}" data-dtype="Number" placeholder="0">
		<input class="input" type="number" name="system.armorDetail.internal.impact" value="{{system.armorDetail.internal.impact}}" data-dtype="Number" placeholder="0">
	</div>
	<div class="flexrow">
		<span class="center">{{localize "SINLESS.System.Armor.Under"}}</span>
		<input class="input" type="number" name="system.armorDetail.under.ballistic" value="{{system.armorDetail.under.ballistic}}" data-dtype="Number" placeholder="0">
		<input class="input" type="number" name="system.armorDetail.under.impact" value="{{system.armorDetail.under.impact}}" data-dtype="Number" placeholder="0">
	</div>
	<div class="flexrow">
		<span class="center">{{localize "SINLESS.System.Armor.Outer"}}</span>
		<input class="input" type="number" name="system.armorDetail.outer.ballistic" value="{{system.armorDetail.outer.ballistic}}" data-dtype="Number" placeholder="0">
		<input class="input" type="number" name="system.armorDetail.outer.impact" value="{{system.armorDetail.outer.impact}}" data-dtype="Number" placeholder="0">
	</div>
</div>