<div class="flexcol">
	<h4 class="center">{{localize "SINLESS.System.Attributes.titlePrimary"}}</h4>
	{{#each system.attributes as |attribute key|}}
	<div class="attribute flexrow">
		<label class="attributeLabel" for="system.attributes.{{key}}.value">{{localize  (concat "SINLESS.System.Attributes." key) }}</label>
		<div class="flexrow">
			<input class="input" type="number" name="system.attributes.{{key}}.value" value="{{attribute.value}}" data-dtype="Number">
			<span class="center"> / </span>
			<input class="input" type="number" name="system.attributes.{{key}}.max" value="{{attribute.max}}" data-dtype="Number">
		</div>
	</div>
	{{/each}}
	<h4 class="center">{{localize "SINLESS.System.Attributes.titleSecondary"}}</h4>
	<div class="attribute flexrow">
		<label class="attributeLabel">ZP</label>
		<span>5 (5.8) / 6</span>
	</div>
	<div class="attribute flexrow">
		<label class="attributeLabel">Body Index</label>
		<input class="input" type="number" value="0" data-dtype="Number" disabled>
	</div>
	<div class="attribute flexrow">
		<label class="attributeLabel">Kismet</label>
		<div class="flexrow">
			<input class="input" type="number" value="0" data-dtype="Number" disabled>
			<span class="center"> / </span>
			<input class="input" type="number" value="0" data-dtype="Number" disabled>
		</div>
	</div>
	<div class="attribute flexrow">
		<label class="attributeLabel">Ghost Rating</label>
		<input class="input" type="number" value="8" data-dtype="Number" disabled>
	</div>
	<div class="flexrow">
		<label class="attributeLabel">Movement</label>
		<span> 3" (6m) </span>
	</div>
	<h4 class="center">{{localize "SINLESS.System.Armor.title"}}</h4>
	<div class="flexrow">
		<span class="center"></span>
		<span class="center">{{localize "SINLESS.System.Armor.Ballistic"}}</span>
		<span class="center">{{localize "SINLESS.System.Armor.Impact"}}</span>
	</div>
	<div class="flexrow">
		<span class="center">{{localize "SINLESS.System.Armor.Internal"}}</span>
		<input class="input" type="number" name="system.armorDetail.internal.ballistic" value="{{system.armorDetail.internal.ballistic}}" data-dtype="Number">
		<input class="input" type="number" name="system.armorDetail.internal.impact" value="{{system.armorDetail.internal.impact}}" data-dtype="Number">
	</div>
	<div class="flexrow">
		<span class="center">{{localize "SINLESS.System.Armor.Under"}}</span>
		<input class="input" type="number" name="system.armorDetail.under.ballistic" value="{{system.armorDetail.under.ballistic}}" data-dtype="Number">
		<input class="input" type="number" name="system.armorDetail.under.impact" value="{{system.armorDetail.under.impact}}" data-dtype="Number">
	</div>
	<div class="flexrow">
		<span class="center">{{localize "SINLESS.System.Armor.Outer"}}</span>
		<input class="input" type="number" name="system.armorDetail.outer.ballistic" value="{{system.armorDetail.outer.ballistic}}" data-dtype="Number">
		<input class="input" type="number" name="system.armorDetail.outer.impact" value="{{system.armorDetail.outer.impact}}" data-dtype="Number">
	</div>
</div>